{
  "name": "suiji-ledger",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "setup": "npm install && npm run db:push",
    "db:push": "npm -w apps/server run db:push",
    "dev:server": "npm -w apps/server run dev",
    "dev:web": "npm -w apps/web run dev",
    "build:web": "npm -w apps/web run build",
    "start": "npm -w apps/server run start",
    "test": "vitest run",
    "m4a:migrate": "node apps/server/scripts/m4a-migrate.mjs",
    "deps:desktop": "node apps/server/scripts/copy-desktop-deps.mjs"
  },
  "devDependencies": {
    "electron-builder": "^25.1.8",
    "vitest": "^2.1.1"
  }
}
